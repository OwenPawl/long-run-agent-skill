{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_relation.v1.schema.json",
  "title": "Typed Evidence Relationship",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "timestamp",
    "source",
    "relation",
    "target",
    "source_run_id",
    "confidence",
    "notes"
  ],
  "$defs": {
    "endpoint": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {
          "enum": ["claim", "claim_revision", "artifact", "run", "friction", "relation"]
        },
        "id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": { "const": "evidence_relation.v1" },
    "id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "minLength": 1 },
    "source": { "$ref": "#/$defs/endpoint" },
    "relation": {
      "enum": [
        "supports",
        "refutes",
        "corroborates",
        "contradicts",
        "derived_from",
        "reproduces",
        "documents",
        "caused_by",
        "supersedes",
        "retracts"
      ]
    },
    "target": { "$ref": "#/$defs/endpoint" },
    "source_run_id": { "type": "string" },
    "confidence": { "type": "string" },
    "notes": { "type": "string" }
  },
  "additionalProperties": true
}
