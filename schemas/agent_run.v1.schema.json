{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_run.v1.schema.json",
  "title": "Agent Run Record",
  "type": "object",
  "required": ["schema_version", "event", "run_id", "timestamp"],
  "properties": {
    "schema_version": { "const": "agent_run.v1" },
    "event": { "enum": ["run_start", "run_close"] },
    "run_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "minLength": 1 },
    "goal": { "type": "string" },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "outcome": { "type": "string" },
    "summary": { "type": "string" },
    "commands_run": { "type": "array", "items": { "type": "string" } },
    "tests_run": { "type": "array", "items": { "type": "string" } },
    "files_changed": { "type": "array", "items": { "type": "string" } },
    "failures": { "type": "array", "items": { "type": "string" } },
    "claims_touched": { "type": "array", "items": { "type": "string" } },
    "artifacts_produced": { "type": "array", "items": { "type": "string" } },
    "evidence_relations": { "type": "array", "items": { "type": "string" } },
    "next_actions": { "type": "array", "items": { "type": "string" } },
    "no_verification_reason": { "type": "string" },
    "status": { "type": "string" }
  },
  "additionalProperties": true
}
