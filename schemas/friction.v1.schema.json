{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "friction.v1.schema.json",
  "title": "Friction Record",
  "type": "object",
  "required": [
    "id",
    "timestamp",
    "source_run_id",
    "category",
    "description",
    "impact",
    "proposed_harness_need",
    "severity",
    "status"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "minLength": 1 },
    "source_run_id": { "type": "string" },
    "category": {
      "enum": [
        "memory_loss",
        "claim_drift",
        "doc_drift",
        "verification_gap",
        "repeated_failure",
        "artifact_discovery_gap",
        "context_packing_gap",
        "roadmap_ambiguity",
        "completion_ambiguity",
        "user_control_gap",
        "state_duplication",
        "overengineering_risk"
      ]
    },
    "description": { "type": "string", "minLength": 1 },
    "impact": { "type": "string", "minLength": 1 },
    "proposed_harness_need": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["low", "medium", "high", "critical"] },
    "status": { "type": "string", "minLength": 1 },
    "event": { "type": "string" },
    "previous_status": { "type": "string" },
    "root_cause_id": { "type": "string" },
    "release_disposition": { "type": "string" },
    "settlement_rationale": { "type": "string" },
    "verification_command": { "type": "string" },
    "next_action": { "type": "string" },
    "related_friction_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "settlement_evidence": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
