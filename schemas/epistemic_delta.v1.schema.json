{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EpistemicDelta v1",
  "type": "object",
  "required": ["operations"],
  "properties": {
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "operation": {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": { "type": "string", "pattern": "^[a-z]+\\.[a-z_]+$" },
        "data": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
